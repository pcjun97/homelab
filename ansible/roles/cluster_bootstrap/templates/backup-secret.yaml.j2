apiVersion: v1
kind: Namespace
metadata:
  name: backup
---
apiVersion: v1
kind: Secret
metadata:
  name: backup
  namespace: backup
data:
  b2_key_id: {{ secrets_values.b2_key_id | b64encode }}
  b2_application_key: {{ secrets_values.b2_application_key | b64encode }}
  bucket: {{ secrets_values.b2_bucket | b64encode }}
  healthchecks_url: {{ secrets_values.healthchecks_backup_url | regex_replace('/$', '') | b64encode }}
