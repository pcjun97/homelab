#!/bin/bash
# Managed by Ansible. Back up app config and media to Backblaze B2 with rclone.
set -euo pipefail
source {{ backup_env }}

for mount in {{ backup_required_mounts | join(' ') }}; do
  if ! mountpoint -q "$mount"; then
    echo "$mount is not mounted; refusing to sync" >&2
    exit 1
  fi
done

rclone_sync() {
  rclone sync "$@" \
    --config {{ backup_rclone_config }} \
    --bwlimit {{ backup_bwlimit }} \
    --max-delete {{ backup_max_delete }} \
    --fast-list \
    --transfers 4 \
    --log-level INFO \
    --stats 10m \
    --stats-log-level NOTICE
}

# Consistent snapshots of live SQLite databases
staging={{ backup_sqlite_staging }}
rm -rf "$staging"
mkdir -p "$staging"
while IFS= read -r -d '' db; do
  if [ "$(head -c 15 "$db")" = "SQLite format 3" ]; then
    dest="$staging/${db#{{ backup_sqlite_root }}/}"
    mkdir -p "$(dirname "$dest")"
    sqlite3 "$db" ".backup '$dest'"
    echo "snapshot: $db"
  fi
done < <(find {{ backup_sqlite_root }} -type f \( -name '*.db' -o -name '*.sqlite' \) -print0)
rclone_sync "$staging" "b2:${BACKUP_BUCKET}/sqlite"

{% for source in backup_sources %}
rclone_sync {{ source.path }} "b2:${BACKUP_BUCKET}/{{ source.name }}"{% for exclude in source.excludes %} \
  --exclude '{{ exclude }}'{% endfor %}

{% endfor %}
echo "backup complete"
